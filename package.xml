<?xml version="1.0"?>
<package format="3">
  <name>odin_ros_driver</name>
  <version>0.14.2</version>
  <description>ROS driver for Odin sensor</description>
  <maintainer email="oliveiratang@manifoldtech.cn">rlk</maintainer>
  <license>Apache 2.0</license>

  <!-- ROS1 uses catkin as the build tool -->
  <buildtool_depend>catkin</buildtool_depend>
  <!-- ROS2 uses colcon as the build tool -->
  <buildtool_depend condition="$ROS_VERSION == 2">ament_cmake</buildtool_depend>

  <!-- ROS1 dependencies -->
  <depend condition="$ROS_VERSION == 1">roscpp</depend>
  <!-- ROS2 dependencies -->
  <depend condition="$ROS_VERSION == 2">rclcpp</depend>
  <depend condition="$ROS_VERSION == 2">ament_index_cpp</depend>

  <!-- Common dependencies -->
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>image_transport</depend>
  <depend>pcl_conversions</depend>
  <depend>message_filters</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>visualization_msgs</depend>

  <!-- System dependencies -->
  <depend>eigen</depend>
  <depend>openssl</depend>
  <depend>pkg-config</depend>
  <depend>yaml-cpp</depend>
  <build_depend>libpcl-all-dev</build_depend>
  <build_export_depend>libpcl-all-dev</build_export_depend>
  <exec_depend>libpcl-common</exec_depend>
  <build_depend>libusb-1.0-dev</build_depend>
  <exec_depend>libusb-1.0</exec_depend>

  <!-- AE/AWB debug services (custom .srv files in srv/) -->
  <build_depend condition="$ROS_VERSION == 1">message_generation</build_depend>
  <build_export_depend condition="$ROS_VERSION == 1">message_runtime</build_export_depend>
  <exec_depend condition="$ROS_VERSION == 1">message_runtime</exec_depend>
  <buildtool_depend condition="$ROS_VERSION == 2">rosidl_default_generators</buildtool_depend>
  <exec_depend condition="$ROS_VERSION == 2">rosidl_default_runtime</exec_depend>
  <member_of_group condition="$ROS_VERSION == 2">rosidl_interface_packages</member_of_group>

  <!-- Specify build type -->
  <export>
    <build_type condition="$ROS_VERSION == 1">catkin</build_type>
    <build_type condition="$ROS_VERSION == 2">ament_cmake</build_type>
  </export> 
</package>